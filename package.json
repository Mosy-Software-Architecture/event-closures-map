  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.js",
    "validate": "node scripts/validate.js",
    "fetch-streets": "node scripts/fetch-streets.js",
    "gpx-to-routes": "node scripts/gpx-to-routes.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/preview.js",
