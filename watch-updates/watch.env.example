# Copy to watch.env (or anywhere) and pass its path to check-updates.sh.
# Never commit the real file: it points at credentials.

# Event data folder (event.json, sources.json and watch/allowed-domains.txt are read from here)
DATA_DIR=/home/me/event-closures-map/data
# Firebase Hosting site id (event.json site.firebase.site)
FIREBASE_SITE=my-firebase-site
# Google credentials able to deploy to that site:
#  - a service account key (JSON), or
#  - an "authorized_user" file from `gcloud auth application-default login` (name it *adc*.json)
CREDENTIALS=/home/me/.config/event-closures-map/adc.json
# Billing project for user credentials, if your organisation requires one
#GOOGLE_CLOUD_QUOTA_PROJECT=my-project
# Optional
#SITE_URL=https://closures.example.org/        # default: event.json site.url
#ALLOWED_DOMAINS=/path/allowed-domains.txt      # default: $DATA_DIR/watch/allowed-domains.txt
#PROMPT_FILE=/path/prompt.md                    # default: $DATA_DIR/watch/prompt.md, else ./prompt.md
#STATE_DIR=$HOME/.local/state/event-closures-map
#CLAUDE_BIN=$HOME/.local/bin/claude
#STOP_AFTER="2027-04-25 16:00"                   # after this, the timer disables itself
#TIMER_UNIT=event-closures-watch.timer
#DRY_RUN=1                                       # do everything except publishing
