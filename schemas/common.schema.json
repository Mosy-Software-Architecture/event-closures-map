{
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "localized": {
      "description": "Plain string, or one string per language code. Rich fields accept **bold** and [text](https://link).",
      "anyOf": [
        { "type": "string" },
        { "type": "object", "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$" }, "additionalProperties": { "type": "string" }, "minProperties": 1 }
      ]
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$", "description": "Absolute https:// URL" },
    "url": { "type": "string", "pattern": "^(https://[^\\s]+|[^:\\s]+)$", "description": "https:// URL or a path relative to the site root" },
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "time": { "type": "string", "pattern": "^([01]?[0-9]|2[0-4]):[0-5][0-9]$", "description": "Local time of the event day, H:MM or HH:MM" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "latLon": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[lat, lon] (Leaflet order)" },
    "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3, "description": "[lon, lat] (GeoJSON order)" },
    "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[west, south, east, north]" },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "enum": ["LineString", "MultiLineString", "Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
